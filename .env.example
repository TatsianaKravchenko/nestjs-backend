# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Registration
REGISTRATION_CONFIRMATION_ENABLED=false
REGISTRATION_CONFIRMATION_METHOD=otp
REGISTRATION_SECRET=change-me-registration-secret
REGISTRATION_MAGIC_LINK_URL=http://localhost:4200/auth/register/confirm
REGISTRATION_THROTTLE_TTL=60000
REGISTRATION_THROTTLE_LIMIT=5

# Authentication (keys: random, >= 32 bytes, all different. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=nestjs-monolith
JWT_AUDIENCE=nestjs-monolith-api
LOGIN_CHALLENGE_HMAC_KEY=
AUTH_LOG_PSEUDONYM_KEY=
LOGIN_EMAIL_CONFIRMATION_ENABLED=false
LOGIN_EMAIL_CONFIRMATION_METHOD=otp
LOGIN_MAGIC_LINK_URL=http://localhost:4200/auth/login/confirm
LOGIN_THROTTLE_TTL=60000
LOGIN_THROTTLE_LIMIT=30
LOGIN_FAILURE_WINDOW_MS=900000
LOGIN_FAILURE_LIMIT=5
REFRESH_THROTTLE_TTL=60000
REFRESH_THROTTLE_LIMIT=30
# Exact origin of a trusted frontend on another origin; set AUTH_COOKIE_CROSS_SITE=true if it is cross-site
AUTH_TRUSTED_ORIGIN=
AUTH_COOKIE_CROSS_SITE=false

# RBAC (id of an existing user who becomes admin on the first, one-time setup)
RBAC_BOOTSTRAP_ADMIN_USER_ID=

# SMTP (confirmation emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true
