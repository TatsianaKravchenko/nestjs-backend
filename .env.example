# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Registration
REGISTRATION_CONFIRMATION_ENABLED=false
REGISTRATION_CONFIRMATION_METHOD=otp
REGISTRATION_SECRET=change-me-registration-secret
REGISTRATION_MAGIC_LINK_URL=http://localhost:4200/auth/register/confirm
REGISTRATION_THROTTLE_TTL=60000
REGISTRATION_THROTTLE_LIMIT=5

# Authentication (keys: random, >= 32 bytes, all different. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=nestjs-monolith
JWT_AUDIENCE=nestjs-monolith-api
LOGIN_CHALLENGE_HMAC_KEY=
AUTH_LOG_PSEUDONYM_KEY=
LOGIN_EMAIL_CONFIRMATION_ENABLED=false
LOGIN_EMAIL_CONFIRMATION_METHOD=otp
LOGIN_MAGIC_LINK_URL=http://localhost:4200/auth/login/confirm
LOGIN_THROTTLE_TTL=60000
LOGIN_THROTTLE_LIMIT=30
LOGIN_FAILURE_WINDOW_MS=900000
LOGIN_FAILURE_LIMIT=5
REFRESH_THROTTLE_TTL=60000
REFRESH_THROTTLE_LIMIT=30
# Exact origin of a trusted frontend on another origin; set AUTH_COOKIE_CROSS_SITE=true if it is cross-site
AUTH_TRUSTED_ORIGIN=
AUTH_COOKIE_CROSS_SITE=false

# RBAC (id of an existing user who becomes admin on the first, one-time setup)
RBAC_BOOTSTRAP_ADMIN_USER_ID=

# User profile (public API base URL for photoUrl: HTTPS in production)
API_PUBLIC_URL=http://localhost:3007
PROFILE_READ_WINDOW_MS=60000
PROFILE_READ_OWN_LIMIT=120
PROFILE_READ_FOREIGN_LIMIT=60
# Local photo storage, single-instance development only
PHOTO_STORAGE_DIR=./storage/photos
# Profile/photo mutations per user per window (30 per hour)
PROFILE_MUTATION_WINDOW_MS=3600000
PROFILE_MUTATION_LIMIT=30

# Email change (key: random, >= 32 bytes, different from every other key)
EMAIL_CHANGE_HMAC_KEY=
EMAIL_CHANGE_METHOD=otp
EMAIL_CHANGE_MAGIC_LINK_URL=http://localhost:4200/profile/email-change/confirm
EMAIL_CHANGE_WINDOW_MS=3600000
EMAIL_CHANGE_HOURLY_LIMIT=5

# Admin user list (task 3.1.7). Cursor keys: `kid:secret` pairs separated by commas,
# each secret random and >= 32 bytes; the active id must be one of the ids.
# A missing/weak setting fails /health/ready and GET /admin/users answers 503.
USER_LIST_CURSOR_ACTIVE_KEY_ID=k1
USER_LIST_CURSOR_HMAC_KEYS=
ADMIN_USERS_LIST_WINDOW_MS=60000
ADMIN_USERS_LIST_ACTOR_LIMIT=60
ADMIN_USERS_LIST_IP_LIMIT=120

# Storage cleanup worker (photo objects of replaced/cleared photos, orphan sweep)
STORAGE_CLEANUP_WORKER_ENABLED=true
STORAGE_CLEANUP_INTERVAL_MS=15000
STORAGE_ORPHAN_SWEEP_INTERVAL_MS=900000

# File transformations (task 2.0). Temp dir: private, never served; empty = <os tmp>/mnt-transformations.
# Storage dir: local stand-in for object storage, single-instance development only.
TRANSFORM_TEMP_DIR=
TRANSFORM_STORAGE_DIR=./storage/transformations
TRANSFORM_TEMP_SWEEP_MAX_AGE_MS=3600000

# Transformation history (task 2.3): 60 requests/min per user; rows older than the retention period are deleted in batches.
TRANSFORM_HISTORY_RATE_LIMIT=60
TRANSFORM_HISTORY_RATE_WINDOW_MS=60000
TRANSFORM_HISTORY_RETENTION_DAYS=90
TRANSFORM_HISTORY_CLEANUP_ENABLED=true
TRANSFORM_HISTORY_CLEANUP_INTERVAL_MS=3600000
TRANSFORM_HISTORY_CLEANUP_BATCH_SIZE=100

# SMTP (confirmation emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# Account deletion (task 1.6). The HMAC key must differ from every other key (>= 32 bytes).
DELETION_CHALLENGE_HMAC_KEY=
DELETION_CONFIRMATION_METHOD=otp
DELETION_MAGIC_LINK_URL=http://localhost:4200/profile/deletion/confirm
DELETION_EMAIL_WINDOW_MS=3600000
DELETION_EMAIL_HOURLY_LIMIT=5
DELETION_STATUS_WINDOW_MS=60000
DELETION_STATUS_LIMIT=60
DELETION_WORKER_ENABLED=true
DELETION_WORKER_INTERVAL_MS=5000
DELETION_WORKER_LEASE_SECONDS=300
