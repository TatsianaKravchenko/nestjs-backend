# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Registration
REGISTRATION_CONFIRMATION_ENABLED=false
REGISTRATION_CONFIRMATION_METHOD=otp
REGISTRATION_SECRET=change-me-registration-secret
REGISTRATION_MAGIC_LINK_URL=http://localhost:4200/auth/register/confirm
REGISTRATION_THROTTLE_TTL=60000
REGISTRATION_THROTTLE_LIMIT=5

# SMTP (confirmation emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true
